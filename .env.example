# Copy to .env and fill in. .env is gitignored - never commit real tokens.

MEMBER=bereket

# --- DagsHub / MLflow ------------------------------------------------------
MLFLOW_TRACKING_URI=https://dagshub.com/<DAGSHUB_OWNER>/<REPO>.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# --- Kaggle (only for whoever downloads the raw data once) -----------------
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-key>
